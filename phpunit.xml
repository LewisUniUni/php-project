<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnAllIssues="true"
>
    <coverage includeUncoveredFiles="true"/>
    <extensions>
        <bootstrap class="Studio\Gesso\PHPUnit\OpenApiCoverageExtension"/>
    </extensions>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:XGUZxtnQ4I6OrQLQLqHkD6mapLrJdpYhWl9UE3Hqjtc="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="redis"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="logistics_test"/>
        <env name="DB_USERNAME" value="logistics_migrator"/>
        <env name="DB_PASSWORD" value="local-migrator-password"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="redis"/>
        <env name="SESSION_DRIVER" value="redis"/>
        <env name="SESSION_CONNECTION" value="cache"/>
        <env name="REDIS_CACHE_HOST" value="127.0.0.1"/>
        <env name="REDIS_CACHE_PORT" value="6379"/>
        <env name="REDIS_QUEUE_HOST" value="127.0.0.1"/>
        <env name="REDIS_QUEUE_PORT" value="6380"/>
        <env name="MONGODB_URI" value="mongodb://127.0.0.1:27017"/>
        <env name="MONGODB_DATABASE" value="logistics_test"/>
        <env name="OUTBOX_NUDGE" value="true"/>
        <env name="LOG_CHANNEL" value="stderr"/>
        <env name="LOG_LEVEL" value="warning"/>
    </php>
</phpunit>
