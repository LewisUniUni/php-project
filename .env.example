APP_NAME=Quay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8411

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

# OpenTelemetry export is off. Grafana displays telemetry; it does not receive OTLP.
# Set TELEMETRY_EXPORT=true only with a collector endpoint you operate.
# Use a different OTEL_SERVICE_NAME for web, the Horizon consumer, and the scheduler.
TELEMETRY_EXPORT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=quay

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logistics
DB_USERNAME=logistics_app
DB_PASSWORD=local-app-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=cache

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6380

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=logistics

OCTANE_SERVER=frankenphp
OUTBOX_NUDGE=true
SLOW_QUERY_MS=200
API_RATE_PER_MINUTE=60
PARTNER_RATE_PER_MINUTE=30
CLIENT_TOKEN_MINUTES=15
METRICS_TOKEN=

SEED_OPERATOR_PASSWORD=local-operator-password
SEED_PLANNER_PASSWORD=local-planner-password
WAREHOUSE_CLIENT_SECRET=local-warehouse-client-secret
DRIVER_CLIENT_SECRET=local-driver-client-secret
PDA_CLIENT_SECRET=local-pda-client-secret
PARTNER_CLIENT_SECRET=local-partner-client-secret

MAIL_MAILER=log
MAIL_FROM_ADDRESS="floor@quay.local"
MAIL_FROM_NAME="${APP_NAME}"
