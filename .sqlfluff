[sqlfluff]
dialect = mysql
templater = raw
max_line_length = 120
# RF05 flags MySQL account names such as 'logistics_app'@'%'.
# LT05 is the layout rule for comma spacing that this init script does not use.
exclude_rules = LT05,RF05

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper
